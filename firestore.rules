rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'SUPER_ADMIN';
    }
    
    function isSocietyAdmin(societyId) {
      return isSignedIn() && (
        getUserData().role == 'SUPER_ADMIN' || 
        (getUserData().role == 'SOCIETY_ADMIN' && getUserData().societyId == societyId)
      );
    }
    
    function isBelongsToSociety(societyId) {
      return isSignedIn() && getUserData().societyId == societyId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Societies Collection
    match /societies/{societyId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Units Collection
    match /units/{unitId} {
      allow read: if isSignedIn();
      allow write: if isSocietyAdmin(resource.data.societyId);
    }

    // Bills Collection
    match /bills/{billId} {
      allow read: if isSignedIn() && (
        isSocietyAdmin(resource.data.societyId) || 
        resource.data.residentId == request.auth.uid
      );
      allow write: if isSocietyAdmin(resource.data.societyId);
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        isSocietyAdmin(resource.data.societyId) || 
        resource.data.residentId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update, delete: if isSocietyAdmin(resource.data.societyId);
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      allow read: if isSignedIn() && isBelongsToSociety(resource.data.societyId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isSocietyAdmin(resource.data.societyId) || 
        resource.data.residentId == request.auth.uid
      );
      allow delete: if isSocietyAdmin(resource.data.societyId);
    }

    // Visitors Collection
    match /visitors/{visitorId} {
      allow read: if isSignedIn() && isBelongsToSociety(resource.data.societyId);
      allow create, update: if isSignedIn();
      allow delete: if isSocietyAdmin(resource.data.societyId);
    }

    // Notices Collection
    match /notices/{noticeId} {
      allow read: if isSignedIn() && isBelongsToSociety(resource.data.societyId);
      allow write: if isSocietyAdmin(resource.data.societyId);
    }

    // Amenities & Bookings
    match /amenities/{amenityId} {
      allow read: if isSignedIn();
      allow write: if isSocietyAdmin(resource.data.societyId);
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn() && isBelongsToSociety(resource.data.societyId);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isSocietyAdmin(resource.data.societyId) || 
        resource.data.residentId == request.auth.uid
      );
    }
  }
}
